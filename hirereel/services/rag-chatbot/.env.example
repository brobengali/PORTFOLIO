# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# LLM (required for answers) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: ordered fallback chain used when a model is overloaded (429/503) or unavailable.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest
# GEMINI_ROUNDS=5            # sweeps across the chain before giving up
# GEMINI_RETRY_BACKOFF=2     # seconds, multiplied by the round number
# GEMINI_TIME_BUDGET=75      # hard cap in seconds per question

# Database — leave DATABASE_URL and DB_* empty to use local SQLite (db.sqlite3).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/rag_chatbot

# Optional: Celery broker (background processing). Not needed for local dev.
# REDIS_URL=redis://localhost:6379/0
