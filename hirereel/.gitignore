# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite
/prisma/dev.db
/prisma/dev.db-journal
/prisma/*.db
/prisma/*.db-journal

# rag-chatbot service (services/rag-chatbot)
services/rag-chatbot/db.sqlite3
services/rag-chatbot/media/
services/rag-chatbot/vectorstore/
services/rag-chatbot/fastembed_cache/
services/rag-chatbot/staticfiles/
services/rag-chatbot/.venv/
services/rag-chatbot/**/__pycache__/
services/rag-chatbot/.pylib/
